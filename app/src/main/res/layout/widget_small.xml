<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="13dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ TIBO"
            android:textColor="#F7F8FB"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">

            <ImageView
                android:id="@+id/refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/refresh"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh" />

            <ProgressBar
                android:id="@+id/refresh_loading"
                style="@android:style/Widget.ProgressBar.Small"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/refreshing"
                android:indeterminate="true"
                android:indeterminateBehavior="repeat"
                android:indeterminateDrawable="@drawable/widget_refresh_spinner"
                android:indeterminateDuration="720"
                android:indeterminateOnly="true"
                android:interpolator="@android:anim/linear_interpolator"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/status_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="⚪ 暂无数据"
        android:textColor="#AEB6C2"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/probability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="24H  —"
        android:textColor="#F7F8FB"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/next_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="下次：—"
        android:textColor="#AEB6C2"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/last_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="上次：—"
        android:textColor="#778190"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Reset Beacon · 尚未同步"
        android:textColor="#778190"
        android:textSize="8sp" />

</LinearLayout>
